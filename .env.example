# ENTROPY local lab configuration
# Copy this file to .env and adjust values for your machine.

# Dashboard
ENTROPY_DASHBOARD_HOST=127.0.0.1
ENTROPY_DASHBOARD_PORT=5000

# Victim read-only UI
ENTROPY_VICTIM_HOST=0.0.0.0
ENTROPY_VICTIM_PORT=8002
# Optional public URLs when running behind a reverse proxy or preview host.
ENTROPY_PUBLIC_VICTIM_URL=
ENTROPY_PUBLIC_DASHBOARD_URL=
ENTROPY_PUBLIC_ATTACKER_URL=
ENTROPY_DEBUG=false
# Development-only default. Replace with a long random value if exposed.
ENTROPY_SECRET_KEY=change-me-for-any-shared-environment
# Optional remote control token for attacker launch/stop/reset routes.
# When empty, those routes accept only loopback clients.
# Empty = loopback-only attacker launch. lab.py sets entropy-lab for remote UI.
ENTROPY_CONTROL_TOKEN=
# Keep terminate/quarantine simulated unless you explicitly opt in.
ENTROPY_DRY_RUN=true

# Detection thresholds
ENTROPY_THRESHOLD=7.5
ENTROPY_DELTA_THRESHOLD=2.0
ENTROPY_FILES_PER_SECOND_THRESHOLD=3.0
ENTROPY_SAMPLE_SIZE_BYTES=65536

# Paths
# Multiple watch folders are separated with the operating system path separator
# (':' on Linux/macOS and ';' on Windows). Relative paths resolve from repo root.
ENTROPY_WATCH_FOLDERS=data/testing
ENTROPY_DB_PATH=entropy.db
ENTROPY_LOG_FILE=logs/entropy_system.log
ENTROPY_QUARANTINE_DIR=quarantine_storage

# Ganache / smart contract
ENTROPY_GANACHE_URL=http://127.0.0.1:7545
ENTROPY_CONTRACT_ADDRESS=
ENTROPY_WALLET_ADDRESS=
ENTROPY_ACCOUNT_INDEX=0
ENTROPY_BLOCKCHAIN_FALLBACK=true
